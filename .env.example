# Required for Gemini AI Reference Analysis, Script Generation, Scene Breakdown, Prompts, TTS & SEO
# Configure in Vercel: Project Settings -> Environment Variables
GEMINI_API_KEY=

# Optional: CodeCraft / OpenAI-Compatible API (https://codecraftapi.com/v1) for Text, Image & Audio Generation
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_TEXT_MODEL=gpt-4o
CODECRAFT_IMAGE_MODEL=dall-e-3
CODECRAFT_TTS_MODEL=tts-1
CODECRAFT_TTS_VOICE=alloy

# Optional: YouTube Data API v3 Key (enriches YouTube Reference metadata with exact duration, view counts & full descriptions)
YOUTUBE_API_KEY=

# Optional: External FFmpeg render backend URL (when omitted, the app uses built-in browser WebCodecs MP4 rendering)
VITE_RENDER_URL=
